# Secrets and credentials — never committed
api.env
*.env
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*
token*
cookies*
# …but the typed secret *loader* is source code, not a secret (D-P2-2).
!src/mlip_research_agent/secrets/
!src/mlip_research_agent/secrets/**

# Python build/tooling caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.coverage
.conda/
venv/
.venv/

# Experiment tracking and heavy data — stays out of git
wandb/
mlruns/
data/raw/
data/cache/
checkpoints/
*.ckpt
*.pt
*.pth
*.onnx

# Full normalized datasets and training exports stay out of git; only their
# manifests/cards/hashes are committed (plan_phase_2.md §4.3).
data_registry/**/normalized_dataset.json
data_registry/**/*.extxyz

# Generated scientific artifacts (small manifests/fixtures/reports that
# demonstrate the repo are committed explicitly, e.g. artifacts/bootstrap/)
artifacts/runs/
artifacts/research/
artifacts/colab/private/
artifacts/vessl/private/
artifacts/compute/
# Real-MACE Auto Research pull-backs contain generated predictions and model
# checkpoints. Keep them local; commit only synthetic regression traces and
# evidence summaries in source documentation.
artifacts/auto_research/ralphthon-mace-*/
# Colab staging pull-backs: JSON records/manifests are committed explicitly;
# model/checkpoint binaries never are.
artifacts/colab_staging/**/*.model
artifacts/colab_staging/**/*.pt
artifacts/colab_staging/**/*.zip

# OS noise
.DS_Store
